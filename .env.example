# --- Pflicht ---
# Bot-Token aus dem Discord Developer Portal
DISCORD_TOKEN=
# API-Key aus dem Riot Developer Portal
RIOT_API_KEY=
# Verbindung zur Datenbank
DATABASE_URL=

# --- Optional ---
# Discord-Webhook für Fehlermeldungen/Monitoring
ALERT_WEBHOOK_URL=
# Server-ID zum Testen von Slash-Commands
TEST_GUILD_ID=
# Stunde (UTC) für die tägliche Zusammenfassung
DAILY_SUMMARY_HOUR_UTC=
# Aktualisierungsintervall in Minuten
UPDATE_MINUTES=
# Einträge pro Leaderboard-Seite
LEADERBOARD_PAGE_SIZE=
# Anzahl der zuletzt geprüften Matches
MATCH_LOOKBACK_COUNT=
# Pause zwischen Riot-API-Anfragen (Rate Limit)
RIOT_REQUEST_DELAY_SECONDS=
# Pause zwischen Google-Sheets-Synchronisierungen
SHEET_SYNC_DELAY_SECONDS=

# Für den Google-Sheets-Export wird zusätzlich eine
# google_credentials.json (Service Account) benötigt.
